[
  {
    "name": "core — import * (full public surface, tree-shaken)",
    "path": "dist/index.js",
    "import": "*",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "280 kB"
  },
  {
    "name": "core — { Button } (single component, guards tree-shaking)",
    "path": "dist/index.js",
    "import": "{ Button }",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "8 kB"
  },
  {
    "name": "core — { Theme } (theming runtime only)",
    "path": "dist/index.js",
    "import": "{ Theme }",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "42 kB"
  }
]
