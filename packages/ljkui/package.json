{
  "name": "ljkui",
  "version": "0.0.1-9",
  "type": "module",
  "description": "ljkui design system",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./styles.lite.css": "./styles.lite.css",
    "./theme.css": "./theme.css",
    "./tailwind": {
      "types": "./dist/tailwind-plugin.d.ts",
      "import": "./dist/tailwind-plugin.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./icons/heroicons": {
      "types": "./dist/icons/adapters/heroicons.d.ts",
      "import": "./dist/icons/adapters/heroicons.js"
    },
    "./icons/hugeicons": {
      "types": "./dist/icons/adapters/hugeicons.d.ts",
      "import": "./dist/icons/adapters/hugeicons.js"
    },
    "./icons/lucide": {
      "types": "./dist/icons/adapters/lucide.d.ts",
      "import": "./dist/icons/adapters/lucide.js"
    },
    "./icons/phosphor": {
      "types": "./dist/icons/adapters/phosphor.d.ts",
      "import": "./dist/icons/adapters/phosphor.js"
    },
    "./icons/tabler": {
      "types": "./dist/icons/adapters/tabler.d.ts",
      "import": "./dist/icons/adapters/tabler.js"
    },
    "./props.json": "./dist/props.json",
    "./llms.txt": "./dist/llms.txt",
    "./llms-full.txt": "./dist/llms-full.txt"
  },
  "bin": {
    "ljkui-lint-raw-colors": "./dist/bin/lint-raw-colors.js"
  },
  "sideEffects": [
    "./dist/icons/adapters/*"
  ],
  "license": "MIT",
  "files": [
    "dist/**",
    "skills",
    "styles.css",
    "styles.lite.css",
    "theme.css"
  ],
  "scripts": {
    "build": "bun run generate:props && bun run build:js && bun run build:css && bun run build:meta",
    "build:js": "tsdown --config tsdown.config.mts && bun scripts/fix-namespace-exports.ts",
    "build:css": "postcss src/styles/index.css -o styles.css && postcss src/styles/theme.css -o theme.css && bun scripts/build-lite-css.ts src/styles/index.css -o styles.lite.css",
    "build:meta": "cp src/generated/props.json dist/props.json && bun scripts/gen-token-seeds.ts && bun scripts/gen-llms-txt.ts",
    "dev:css": "postcss src/styles/index.css -o styles.css --watch",
    "dev:theme": "postcss src/styles/theme.css -o theme.css --watch",
    "health": "bun x publint && bun x @arethetypeswrong/cli --pack . --profile esm-only --exclude-entrypoints styles.css styles.lite.css theme.css llms.txt llms-full.txt",
    "lint": "bun run lint:js && bun run lint:css",
    "lint:js": "bun x oxlint src examples fixture-support",
    "lint:css": "stylelint \"src/**/*.css\"",
    "generate:emoji-colors": "bun scripts/emoji-colors/generate.ts",
    "generate:icon-adapters": "bun scripts/generate-icon-adapters.ts",
    "generate:palettes": "bun scripts/generate-palettes.ts && bun run generate:tokens-snapshot",
    "generate:props": "bun scripts/gen-props.ts",
    "generate:tokens-snapshot": "bun scripts/gen-token-snapshot.ts",
    "check:props": "bun scripts/check-props.ts",
    "check:root-class": "bun scripts/check-root-class.ts",
    "check:css-index": "bun scripts/gen-css-index.ts --check",
    "generate:css-index": "bun scripts/gen-css-index.ts",
    "check:tokens": "bun scripts/gen-token-snapshot.ts --check",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf styles.css && rm -rf styles.lite.css && rm -rf theme.css && rm -rf dist-uight",
    "size": "size-limit",
    "prepublishOnly": "bun scripts/check-version.ts && bun run lint && bun run build",
    "release": "npm version prerelease --no-git-tag-version --no-workspaces-update && npm publish --tag latest",
    "typecheck": "tsc --noEmit",
    "generate:fixtures": "bun run generate:props && bun scripts/gen-fixtures.ts",
    "dev": "bun run generate:fixtures && vite",
    "build:explorer": "bun run generate:fixtures && uight build",
    "generate:prebundle": "bun scripts/gen-prebundle.ts",
    "check:prebundle": "bun scripts/gen-prebundle.ts --check",
    "check:explorer": "bun scripts/check-explorer.ts",
    "check:skills": "bun scripts/check-skills.ts && bun x @tanstack/intent@latest validate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@internationalized/date": "^3.12.2",
    "@react-aria/calendar": "^3.10.1",
    "@react-aria/datepicker": "^3.17.1",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/utils": "^3.34.1",
    "@react-stately/calendar": "^3.10.1",
    "@react-stately/datepicker": "^3.17.1",
    "classnames": "^2.5.1",
    "color-convert": "^3.1.3",
    "credit-card-type": "^10.3.0",
    "react-aria-components": "^1.19.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@heroicons/react": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "@hugeicons/core-free-icons": ">=1.0.0",
    "@hugeicons/react": ">=1.0.0",
    "@phosphor-icons/react": "^2.0.0",
    "@tabler/icons-react": ">=2.0.0",
    "@types/react": "*",
    "@types/react-dom": "*",
    "lucide-react": ">=0.300.0",
    "react": "^17.0 || ^18.0 || ^19.0",
    "react-dom": "^17.0 || ^18.0 || ^19.0"
  },
  "peerDependenciesMeta": {
    "@heroicons/react": {
      "optional": true
    },
    "@hugeicons/core-free-icons": {
      "optional": true
    },
    "@hugeicons/react": {
      "optional": true
    },
    "@phosphor-icons/react": {
      "optional": true
    },
    "@tabler/icons-react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aussieljk/uight": "0.0.1-canary.3",
    "@heroicons/react": "^2.2.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@napi-rs/canvas": "^1.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@size-limit/preset-small-lib": "^13.0.2",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/color-convert": "^2.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "color-convert": "^3.1.3",
    "emoji-datasource": "^16.0.0",
    "lucide-react": "^1.26.0",
    "node-vibrant": "^4.0.4",
    "postcss": "^8.5.22",
    "postcss-cli": "^11.0.1",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "postcss-custom-media": "^12.0.1",
    "postcss-discard-empty": "^8.0.1",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "size-limit": "^13.0.2",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vite": "^8.1",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://ljkui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aussieljk/ljkui.git"
  },
  "bugs": {
    "url": "https://github.com/aussieljk/ljkui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "tailwindcss",
    "tanstack-intent"
  ]
}
